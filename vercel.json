{
  "version": 2,
  "builds": [
    { "src": "index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/index.js" },
    { "src": "/public/(.*)", "dest": "/public/$1" },
    { "src": "/(.*\\.(css|js|png|jpg|ico|svg|gif|woff|woff2|ttf))", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/index.js" }
  ]
}
